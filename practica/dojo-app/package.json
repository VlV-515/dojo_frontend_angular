{
  "name": "dojo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Mini app Angular del Dojo Frontend Angular: catálogo de almacenes contra el dojo-api",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration=mock",
    "build": "ng build",
    "build:development": "ng build --configuration=development",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "reto:a": "jest --config jest.retos.config.js reto-a",
    "reto:b": "jest --config jest.retos.config.js reto-b",
    "reto:c": "jest --config jest.retos.config.js reto-c",
    "retos": "jest --config jest.retos.config.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@testing-library/angular": "19.5.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.1",
    "angular-eslint": "21.4.0",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
