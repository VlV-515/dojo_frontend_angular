@@ -0,0 +1,49 @@
+<app-page-header titulo="Cajas" subtitulo="Cajas registradoras por almacén" />
+
+<mat-form-field appearance="outline">
+  <mat-label>Almacén</mat-label>
+  <mat-select [value]="almacenId()" (selectionChange)="elegirAlmacen($event.value)">
+    @for (almacen of almacenes(); track almacen.id) {
+      <mat-option [value]="almacen.id">{{ almacen.clave }} · {{ almacen.nombre }}</mat-option>
+    }
+  </mat-select>
+</mat-form-field>
+
+@if (almacenElegido(); as almacen) {
+  <form
+    *appSiPermiso="'cajas.editar'"
+    [formGroup]="form"
+    (ngSubmit)="agregar()"
+    class="alta"
+    novalidate
+  >
+    <mat-form-field appearance="outline">
+      <mat-label>Nombre de la caja</mat-label>
+      <input matInput formControlName="nombre" maxlength="60" autocomplete="off" required />
+      @if (form.controls.nombre.invalid) {
+        <mat-error>{{ mensajeError(form.controls.nombre) }}</mat-error>
+      }
+    </mat-form-field>
+    <button mat-flat-button type="submit">Agregar caja</button>
+  </form>
+
+  <table mat-table [dataSource]="cajas()" aria-label="Cajas">
+    <ng-container matColumnDef="nombre">
+      <th mat-header-cell *matHeaderCellDef>Nombre</th>
+      <td mat-cell *matCellDef="let caja">{{ caja.nombre }}</td>
+    </ng-container>
+    <ng-container matColumnDef="estado">
+      <th mat-header-cell *matHeaderCellDef>Estado</th>
+      <td mat-cell *matCellDef="let caja">{{ caja.abierta ? 'Abierta' : 'Cerrada' }}</td>
+    </ng-container>
+    <tr mat-header-row *matHeaderRowDef="columnas"></tr>
+    <tr mat-row *matRowDef="let fila; columns: columnas"></tr>
+    <tr class="mat-row" *matNoDataRow>
+      <td class="mat-cell" [attr.colspan]="columnas.length">
+        {{ cargando() ? 'Cargando…' : 'Este almacén no tiene cajas' }}
+      </td>
+    </tr>
+  </table>
+} @else {
+  <p>Elige un almacén para ver sus cajas.</p>
+}
