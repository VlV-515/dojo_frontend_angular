@@ -0,0 +1,99 @@
+import { ChangeDetectionStrategy, Component, computed, inject, signal } from '@angular/core';
+import { takeUntilDestroyed, toSignal } from '@angular/core/rxjs-interop';
+import { NonNullableFormBuilder, ReactiveFormsModule, Validators } from '@angular/forms';
+import { MatButtonModule } from '@angular/material/button';
+import { MatFormFieldModule } from '@angular/material/form-field';
+import { MatInputModule } from '@angular/material/input';
+import { MatSelectModule } from '@angular/material/select';
+import { MatTableModule } from '@angular/material/table';
+import { ErrorApp } from '@core/errores/error-app';
+import { NotificacionService } from '@core/ui/notificacion.service';
+import { PageHeaderComponent } from '@shared/components/page-header/page-header.component';
+import { SiPermisoDirective } from '@shared/directives/si-permiso.directive';
+import { mensajeError, noSoloEspacios } from '@shared/validators/texto.validators';
+import { AlmacenesService } from '../../../almacenes/services/almacenes.service';
+import { Caja } from '../../models/caja.model';
+import { CajasService } from '../../services/cajas.service';
+import { Subject, catchError, of, switchMap } from 'rxjs';
+
+/** Cajas por almacén: elegir almacén, ver sus cajas y agregar nuevas. */
+@Component({
+  selector: 'app-cajas-lista',
+  imports: [
+    ReactiveFormsModule,
+    MatSelectModule,
+    MatFormFieldModule,
+    MatInputModule,
+    MatButtonModule,
+    MatTableModule,
+    PageHeaderComponent,
+    SiPermisoDirective,
+  ],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  templateUrl: './cajas-lista.component.html',
+})
+export class CajasListaComponent {
+  private readonly cajasService = inject(CajasService);
+  private readonly notificacion = inject(NotificacionService);
+
+  /** Solo almacenes activos: a uno inactivo no se le agregan cajas. */
+  protected readonly almacenes = toSignal(inject(AlmacenesService).listar(true), {
+    initialValue: [],
+  });
+  protected readonly almacenId = signal<number | null>(null);
+  protected readonly cajas = signal<Caja[]>([]);
+  protected readonly cargando = signal(false);
+  protected readonly columnas = ['nombre', 'estado'];
+  protected readonly mensajeError = mensajeError;
+
+  protected readonly almacenElegido = computed(() =>
+    this.almacenes().find((a) => a.id === this.almacenId()),
+  );
+
+  protected readonly form = inject(NonNullableFormBuilder).group({
+    nombre: ['', [Validators.required, noSoloEspacios, Validators.maxLength(60)]],
+  });
+
+  /** Cada almacén elegido; switchMap cancela la consulta anterior si el usuario cambia rápido. */
+  private readonly seleccion$ = new Subject<number>();
+
+  constructor() {
+    this.seleccion$
+      .pipe(
+        switchMap((id) =>
+          this.cajasService.listarPorAlmacen(id).pipe(catchError(() => of<Caja[]>([]))),
+        ),
+        takeUntilDestroyed(),
+      )
+      .subscribe((cajas) => {
+        this.cajas.set(cajas);
+        this.cargando.set(false);
+      });
+  }
+
+  protected elegirAlmacen(id: number): void {
+    this.almacenId.set(id);
+    this.cajas.set([]);
+    this.cargando.set(true);
+    this.seleccion$.next(id);
+  }
+
+  protected agregar(): void {
+    const almacenId = this.almacenId();
+    if (almacenId === null || this.form.invalid) {
+      this.form.markAllAsTouched();
+      return;
+    }
+    const nombre = this.form.getRawValue().nombre.trim();
+    this.cajasService.crear({ nombre, almacen_id: almacenId }).subscribe({
+      next: (caja) => {
+        this.cajas.update((lista) => [...lista, caja]);
+        this.form.reset();
+        this.notificacion.exito(`Caja ${caja.nombre} registrada`);
+      },
+      error: (err: ErrorApp) => {
+        if (!err.notificado) this.notificacion.error(err.message);
+      },
+    });
+  }
+}
diff --color -ruN -x node_modules -x dist -x .angular -x coverage a/dojo-app/src/app/features/cajas/services/cajas.service.ts b/dojo-app/src/app/features/cajas/services/cajas.service.ts
--- a/dojo-app/src/app/features/cajas/services/cajas.service.ts	1969-12-31 18:00:00
+++ b/dojo-app/src/app/features/cajas/services/cajas.service.ts	2026-11-01 17:17:31
@@ -0,0 +1,21 @@
+import { HttpClient, HttpParams } from '@angular/common/http';
+import { Injectable, inject } from '@angular/core';
+import { API_URL } from '@core/http/api-url';
+import { Respuesta } from '@core/modelos/respuesta.model';
+import { Observable, map } from 'rxjs';
+import { Caja, CajaAlta } from '../models/caja.model';
+
+@Injectable({ providedIn: 'root' })
+export class CajasService {
+  private readonly http = inject(HttpClient);
+  private readonly url = `${inject(API_URL)}/cajas`;
+
+  listarPorAlmacen(almacenId: number): Observable<Caja[]> {
+    const params = new HttpParams().set('almacen_id', almacenId);
+    return this.http.get<Respuesta<Caja[]>>(this.url, { params }).pipe(map((r) => r.datos ?? []));
+  }
+
+  crear(alta: CajaAlta): Observable<Caja> {
+    return this.http.post<Respuesta<Caja>>(this.url, alta).pipe(map((r) => r.datos));
+  }
