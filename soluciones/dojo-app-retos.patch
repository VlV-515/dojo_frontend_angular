+  id: number;
+  nombre: string;
+  almacen_id: number;
+  abierta: boolean;
+}
+
+/** Cuerpo de `POST /cajas`. */
+export interface CajaAlta {
+  nombre: string;
+  almacen_id: number;
+}
diff --color -ruN -x node_modules -x dist -x .angular -x coverage a/dojo-app/src/app/features/cajas/pages/cajas-lista/cajas-lista.component.html b/dojo-app/src/app/features/cajas/pages/cajas-lista/cajas-lista.component.html
